# webpack.common.js copies a handful of vendored files straight out of node_modules
# (see vendorPatterns) via copy-webpack-plugin, which doesn't follow symlinks by
# default. pnpm's default isolated layout -- where every package under node_modules
# is a link into node_modules/.pnpm -- would make those copies silently resolve to
# nothing. The hoisted linker writes real directories instead, the way npm did.
node-linker=hoisted
