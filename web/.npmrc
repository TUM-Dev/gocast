# web/node_modules is embedded into the Go binary (//go:embed node_modules in
# router.go) and served straight to browsers at /static/node_modules/... . go:embed
# does not follow symlinks, so pnpm's default isolated layout -- where every package
# under node_modules is a link into node_modules/.pnpm -- would embed nothing at all.
# The hoisted linker writes real directories instead, the way npm did.
node-linker=hoisted
