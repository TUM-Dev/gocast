{{define "shortcuts"}}
    <div class="border rounded-lg shadow-lg text-3 bg-white dark:bg-secondary dark:border-gray-800 w-[90vw] max-w-xl">
        <div class="flex justify-between items-center border-b dark:border-gray-800 px-5 py-3">
            <div class="flex items-center gap-2">
                <i class="fa-solid fa-keyboard text-4"></i>
                <h6 class="text-sm font-bold">Keyboard Shortcuts</h6>
            </div>
            <button type="button" title="Close shortcuts" @click="showShortcuts = false">
                <i class="fa-solid fa-xmark text-4 hover:text-1"></i>
            </button>
        </div>
        <div class="grid md:grid-cols-2 gap-x-8 gap-y-1 p-5">
            {{/* -- Playback -- */}}
            <div class="md:col-span-2 mb-1">
                <span class="text-xs font-semibold uppercase tracking-wider text-4">Playback</span>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Play / Pause</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">k</kbd>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Play / Pause (seekbar focused)</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 uppercase shadow-sm">space</kbd>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Mute / Unmute</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">m</kbd>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Fullscreen</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">f</kbd>
            </div>

            {{/* -- Navigation -- */}}
            <div class="md:col-span-2 mt-3 mb-1 border-t dark:border-gray-800 pt-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-4">Navigation</span>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Seek backwards (10s)</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">j</kbd>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Seek forwards (10s)</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">l</kbd>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Seek to 10% – 90%</p>
                <div class="flex items-center gap-1">
                    <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">1</kbd>
                    <span class="text-4 text-xs">–</span>
                    <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">9</kbd>
                </div>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Seek to beginning</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">0</kbd>
            </div>

            {{/* -- Volume & Speed -- */}}
            <div class="md:col-span-2 mt-3 mb-1 border-t dark:border-gray-800 pt-3">
                <span class="text-xs font-semibold uppercase tracking-wider text-4">Volume &amp; Speed</span>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Increase volume</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm"><i class="fa-solid fa-arrow-up text-[0.6rem]"></i></kbd>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Decrease volume</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm"><i class="fa-solid fa-arrow-down text-[0.6rem]"></i></kbd>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Decrease playback rate</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">&lt;</kbd>
            </div>
            <div class="flex items-center justify-between py-1">
                <p class="text-sm text-5 m-0">Increase playback rate</p>
                <kbd class="inline-flex items-center justify-center min-w-[2rem] px-3 py-1.5 rounded bg-gray-100 dark:bg-secondary-light border border-gray-200 dark:border-gray-700 text-xs font-semibold text-5 shadow-sm">&gt;</kbd>
            </div>
        </div>
    </div>
{{end}}