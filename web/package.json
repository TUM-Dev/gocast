{
  "name": "tum-live",
  "version": "1.0.0",
  "packageManager": "pnpm@10.15.1",
  "description": "Backend of TUMs live streaming service",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TUM-Dev/gocast.git"
  },
  "scripts": {
    "postinstall": "pnpm run build && pnpm run tailwind-compile",
    "tailwind-compile": "NODE_ENV=production tailwindcss -i assets/css/main.css --minify -o ./assets/css-dist/main.css && tailwindcss -i assets/css/home.css --minify -o ./assets/css-dist/home.css",
    "tailwind-compile-home": "NODE_ENV=production tailwindcss -i assets/css/home.css --minify -o ./assets/css-dist/home.css",
    "lint": "eslint ts",
    "lint-fix": "eslint ts --quiet --fix",
    "build": "webpack --config webpack.prod.js",
    "build-dev": "webpack --config webpack.dev.js & tailwindcss -i assets/css/main.css -o ./assets/css-dist/main.css --watch & tailwindcss -i assets/css/home.css -o ./assets/css-dist/home.css --watch"
  },
  "author": "Joscha Henningsen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TUM-Dev/gocast/issues"
  },
  "homepage": "https://github.com/TUM-Dev/gocast#readme",
  "dependencies": {
    "@alpinejs/focus": "^3.13.3",
    "@alpinejs/persist": "^3.13.3",
    "@fortawesome/fontawesome-free": "^7.0.0",
    "alpinejs": "^3.13.3",
    "http-status-codes": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.1.1",
    "tailwindcss": "^4.0.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "webpack": "^5.105.0",
    "webpack-cli": "^7.0.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher",
      "core-js"
    ]
  }
}
