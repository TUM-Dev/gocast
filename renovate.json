{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:allNonMajor",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "ignoreDeps": [
    "github.com/TUM-Dev/gocast/worker",
    "github.com/TUM-Dev/gocast/runner"
  ],
  "enabledManagers": ["npm", "gomod", "dockerfile", "docker-compose", "github-actions"],
  "schedule": ["before 6am on Monday"],
  "packageRules": [
    {
      "description": "Group all non-major updates into a single PR",
      "groupName": "all non-major dependencies",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupSlug": "all-non-major"
    },
    {
      "description": "Group all major updates by manager",
      "groupName": "major {{manager}} updates",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Group all Docker updates together",
      "groupName": "docker dependencies",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Group all GitHub Actions updates together",
      "groupName": "github-actions dependencies",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"]
    },
    {
      "description": "Group all Go module updates together",
      "groupName": "go dependencies",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group all npm updates together",
      "groupName": "npm dependencies",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    }
  ]
}
