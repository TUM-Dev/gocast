{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "ignoreDeps": [
    "github.com/TUM-Dev/gocast/worker",
    "github.com/TUM-Dev/gocast/runner"
  ],
  "enabledManagers": ["npm", "gomod", "dockerfile", "docker-compose", "github-actions"],
  "schedule": ["* 0-6 1 * *"],
  "prCreation": "not-pending",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 0,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"],
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "description": "Group all major updates by manager",
      "groupName": "major {{manager}} updates",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Group all Docker updates together",
      "groupName": "docker dependencies",
      "groupSlug": "docker-non-major",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Group all GitHub Actions updates together",
      "groupName": "github-actions dependencies",
      "groupSlug": "github-actions-non-major",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"]
    },
    {
      "description": "Group all Go module updates together",
      "groupName": "go dependencies",
      "groupSlug": "go-non-major",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Group all npm updates together",
      "groupName": "npm dependencies",
      "groupSlug": "npm-non-major",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "description": "Keep the Go toolchain in one PR: the golang base images and the go directive in every go.mod. CI reads its version from go.mod via go-version-file, so it follows automatically. Must stay last so it wins over the per-manager grouping above.",
      "groupName": "go toolchain",
      "groupSlug": "go-toolchain",
      "matchDatasources": ["docker", "golang-version"],
      "matchPackageNames": ["golang", "go"],
      "enabled": true
    }
  ]
}
