{
  "name": "gocast-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Vite single-page frontend for GoCast, migrated page by page from the server-rendered templates in web/template.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"require('fs').rmSync('../web/spa/assets',{recursive:true,force:true})\"",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "proto": "cd ../apiv2 && buf generate --template buf.gen.es.yaml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "pinia": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.11.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0"
  }
}
