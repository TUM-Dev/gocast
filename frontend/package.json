{
  "name": "gocast-frontend",
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "private": true,
  "description": "Vite single-page frontend for GoCast, the only frontend; the Go server embeds its build from web/spa.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:pwa": "GOCAST_PWA_DEV=1 vite",
    "prebuild": "node -e \"require('fs').rmSync('../web/spa/assets',{recursive:true,force:true})\"",
    "build": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.sw.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.sw.json",
    "proto": "cd ../apiv2 && buf generate --template buf.gen.es.yaml",
    "icons": "node scripts/build-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.0",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@silvermine/videojs-airplay": "^1.3.0",
    "chart.js": "^4.4.1",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "pinia": "^4.0.0",
    "video.js": "8.24.0",
    "videojs-sprite-thumbnails": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
